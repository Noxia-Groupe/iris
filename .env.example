# IRIS — configuration Docker Compose (copier vers .env à la racine du dépôt)
#
# Ce fichier configure les services Docker Compose : PostgreSQL et les variables
# disponibles au build/runtime de la stack. Il NE remplace pas server/.env : copiez
# également server/.env.example vers server/.env pour le SSO, JWT et l'accès de secours.
# Ne commitez jamais les deux fichiers .env créés ; ils sont ignorés par Git.

# -----------------------------------------------------------------------------
# PostgreSQL — obligatoire pour docker-compose
# -----------------------------------------------------------------------------
# Compte initial créé seulement si le volume postgres_data est vierge.
# Après le premier démarrage, modifier ces valeurs ne renomme pas la base ni le compte.
POSTGRES_USER=iris
# Secret : utiliser un mot de passe long, aléatoire et propre à l'instance.
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=iris

# Adresse pour les outils exécutés DEPUIS l'hôte (optionnelle).
# Docker Compose construit lui-même DATABASE_URL du backend avec le service "db".
# DATABASE_URL=postgresql://iris:CHANGE_ME_POSTGRES_PASSWORD@localhost:5432/iris?schema=public

# -----------------------------------------------------------------------------
# Frontend et développement (optionnels)
# -----------------------------------------------------------------------------
# URL compilée dans le frontend Vite. En Docker derrière le proxy, conserver /api.
# VITE_API_URL=/api
# Cible du proxy Vite en développement local (défaut : http://localhost:3001).
# VITE_DEV_API_TARGET=http://localhost:3001

# -----------------------------------------------------------------------------
# Tests locaux / E2E (optionnels — ne pas utiliser en production)
# -----------------------------------------------------------------------------
# Base PostgreSQL jetable, distincte de toute base de développement ou production.
# TEST_DATABASE_URL=postgresql://iris_test:CHANGE_ME_TEST_PASSWORD@localhost:5432/iris_test?schema=public
# E2E_DATABASE_URL=postgresql://iris_e2e:CHANGE_ME_E2E_PASSWORD@localhost:5432/iris_e2e?schema=public
# E2E_BASE_URL=http://localhost:5199
# E2E_API_PORT=3001
# CI est fourni par GitHub Actions : ne pas le définir manuellement.
