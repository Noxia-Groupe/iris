generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String  @id @default(uuid())
  email         String  @unique
  name          String
  // SUPERADMIN, ADMIN, CONDUCTEUR_TRAVAUX, COMMERCIAL, ou l'un des types complémentaires
  // (cf. docs/MODELE-DROITS-COMPTES.md et ALLOWED_ROLES côté serveur).
  // SUPERADMIN = tous les droits d'un ADMIN + les réglages réservés à la direction
  // (gestion des comptes superadmin, activation/désactivation des modules — cf.
  // Parametres.planningActif). Un ADMIN ne peut ni créer, ni modifier, ni supprimer
  // un compte SUPERADMIN, ni s'attribuer ce rôle (cf. isSuperAdminRole côté serveur).
  role          String  @default("CONDUCTEUR_TRAVAUX")
  password      String?
  theme         String  @default("light") // "light" ou "dark" — préférence d'affichage, par compte
  // Un ADMIN (ou SUPERADMIN) marqué estCommercial garde tous ses droits d'administration, mais apparaît
  // EN PLUS comme un commercial : choix possible de "Commercial rattaché" sur un chantier,
  // et statistiques/marges dans "Mes commerciaux" (cf. isCommercialLike côté serveur).
  // Sans effet pour les rôles CONDUCTEUR_TRAVAUX/COMMERCIAL (un COMMERCIAL l'est déjà).
  estCommercial Boolean @default(false)
  // Accès aux données financières (facturation et paiements, à venir). Indépendant du rôle :
  // il s'accorde à n'importe quel compte — conducteur, commercial, administrateur —
  // depuis Administration > Utilisateurs. Un SUPERADMIN y a toujours accès sans avoir
  // besoin de cette case. Seul un superadmin peut l'accorder ou la retirer : ces données
  // (encaissements, impayés, montants clients) relèvent de la direction.
  accesFinance  Boolean @default(false)
  // Permissions accordées individuellement en complément des droits par défaut du type
  // de compte. Elles ne retirent jamais un droit du type ; un retrait explicite sera une
  // évolution distincte, pour préserver les accès historiques lors de la migration.
  permissions   String[] @default([])
  // Rattachement hiérarchique explicite, indépendant du rôle : un collaborateur relève
  // d'un responsable déterminé (sûreté, informatique, télécom…). Réglé dans Administration >
  // Utilisateurs ; un compte Responsable supervise toute sa branche (collaborateurs directs,
  // puis les leurs). Jamais soi-même (contrainte SQL), ni en boucle (refusé par l'API).
  responsableHierarchiqueId String?
  responsableHierarchique   User? @relation("ResponsableCollaborateurs", fields: [responsableHierarchiqueId], references: [id])
  collaborateurs User[] @relation("ResponsableCollaborateurs")
  // Compte actif. Désactiver vaut départ de l'entreprise : la connexion est refusée et le
  // compte disparaît des listes d'attribution (conducteur responsable, commercial
  // rattaché), MAIS tout son historique est conservé — les chantiers qu'il a suivis lui
  // restent rattachés, contrairement à une révocation qui les détache. Réversible.
  actif         Boolean @default(true)

  chantiersGeres          Chantier[]                 @relation("ChantierResponsable") // Liaison pour restreindre la vue des chefs de chantier
  chantiersCommercialises Chantier[]                 @relation("ChantierCommercial") // Chantiers vendus par ce commercial
  primesMensuelles        PrimeMensuelleCommercial[] // Primes "suivi administratif" validées par mois, si commercial
  profilIntervenant       Intervenant?               @relation("IntervenantCompte")
  rapportsIntervention    InterventionRapport[]
  reglementsSaisis        Reglement[]                @relation("ReglementAuteur")
  reglementsContrepasses  Reglement[]                @relation("ReglementContrepassation")
  journauxSaisie          JournalSaisieChantier[]     @relation("JournalSaisieChantierAuteur")
  journauxComptables      JournalCompteComptable[]
  journauxRegles          JournalRegleComptable[]
  achatsCrees             AchatReel[]                 @relation("AchatReelCreePar")
  achatsMisAJour          AchatReel[]                 @relation("AchatReelMisAJourPar")
  pointagesCrees          PointageHeure[]             @relation("PointageHeureCreePar")
  pointagesMisAJour       PointageHeure[]             @relation("PointageHeureMisAJourPar")
  achatsArchives          AchatReel[]                 @relation("AchatReelArchivePar")
  pointagesArchives       PointageHeure[]             @relation("PointageHeureArchivePar")
  coutsInterventionHeures CoutInterventionHeure[]     @relation("CoutInterventionHeureCreePar")
  coutsInterventionAchats CoutInterventionAchat[]     @relation("CoutInterventionAchatCreePar")
  coutsInterventionHeuresArchives CoutInterventionHeure[] @relation("CoutInterventionHeureArchivePar")
  coutsInterventionAchatsArchives CoutInterventionAchat[] @relation("CoutInterventionAchatArchivePar")
  signaturesDevisEnregistrees DevisSignature[]        @relation("DevisSignatureEnregistreePar")
  signaturesInterventionEnregistrees InterventionSignature[] @relation("InterventionSignatureEnregistreePar")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([responsableHierarchiqueId])
}

model Fournisseur {
  id      String  @id @default(uuid())
  nom     String  @unique
  contact String?

  achats AchatReel[]
  coutsInterventionAchats CoutInterventionAchat[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Chantier {
  id          String    @id @default(uuid())
  nom         String
  // Référence de l'affaire, reprise du devis Iris dont le chantier est issu (A26-0001).
  // Format et unicité sont
  // exigés À LA SAISIE (cf. erreurNumeroDevis / numeroDevisDejaPris côté serveur), mais
  // volontairement PAS par une contrainte de base : des chantiers antérieurs portent une
  // valeur libre — deux numéros dans le même champ, par exemple, quand un chantier couvre
  // deux devis du même client. Un index unique les rendrait impossibles à enregistrer et
  // bloquerait la migration ; la règle ne s'applique donc qu'aux nouvelles saisies.
  numeroDevis String?
  client      String
  // Lien relationnel ajouté pour les flux aval (facture, traçabilité) ; le libellé historique reste affichable.
  clientId    String?
  clientFiche Client? @relation("ChantierClient", fields: [clientId], references: [id], onDelete: Restrict)
  // Adresse du site (facultative), saisie librement et toujours corrigible. Seule source de vérité pour les affectations "chantier suivi" du
  // planning d'intervention (cf. PlanningEvent) : jamais dupliquée/surchargée par affectation.
  adresse     String?
  dateDebut   DateTime
  dateFin     DateTime?
  statut      String    @default("EN_COURS")
  types       String[]  @default([]) // Vidéo, Alarme, Contrôle d'accès, Interphonie, Câblage réseau... (plusieurs possibles)

  budgetGlobalVendu     Decimal @db.Decimal(12, 2)
  budgetMaterielVendu   Decimal @default(0) @db.Decimal(12, 2)
  budgetMainOeuvreVendu Decimal @default(0) @db.Decimal(12, 2)
  heuresVendues         Decimal @default(0) @db.Decimal(10, 2)
  // Coût d'achat prévu du matériel, figé à la conversion du devis en chantier (lot « budget et heures
  // prévues du chantier », décision de Nelson de la nuit du 26 au 27-10-2026, point 15) : prix d'achat
  // prévu × quantité, arrondi au centime, de chaque ligne du devis qui en porte un, fourniture ou
  // main-d'œuvre (sous-traitance), une fourniture sans prix d'achat comptant pour zéro (réponses de
  // Nelson du 30-10-2026). Vide pour un chantier créé à la main ou converti avant le lot : sa
  // marge estimée garde le ratio des chantiers terminés. Lu par qui lit le prix d'achat prévu des devis
  // ou reçoit la rentabilité du chantier (réponse de Nelson du 30-10-2026, « Ouvrir la lecture »).
  coutMaterielPrevu     Decimal? @db.Decimal(12, 2)

  // Rémunération commerciale : bascule vers le barème réduit au lieu du barème standard
  // (cf. ParametresRemuneration.baremeReduit et son libellé configurable). Sans effet sur
  // un montant tant qu'aucun plan commercial n'est attribué (décision du 17-10-2026).
  baremeReduit     Boolean   @default(false)
  // Clause de sécurisation : un chantier ne compte dans le CA et la marge validés du
  // commercial que s'il est Terminé ET Encaissé.
  encaisse         Boolean   @default(false)
  dateEncaissement DateTime?

  // Archivage sur annulation du devis dont le chantier est issu. Le chantier n'est jamais
  // détruit — sa raison d'archivage doit rester lisible — mais il sort des listes, des
  // coûts, des marges et des commissions, exactement comme une écriture archivée.
  annuleLe         DateTime?
  annuleParId      String?
  motifAnnulation  String?

  responsableId String?
  responsable   User?   @relation("ChantierResponsable", fields: [responsableId], references: [id])

  commercialId String?
  commercial   User?   @relation("ChantierCommercial", fields: [commercialId], references: [id])

  lignesBudget   LigneBudgetPrevisionnel[]
  achats         AchatReel[]
  pointages      PointageHeure[]
  planningEvents PlanningEvent[]
  interventions  Intervention[]
  factures       Facture[] @relation("FactureChantier")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([responsableId])
  @@index([commercialId])
}

model Categorie {
  id          String  @id @default(uuid())
  nom         String  @unique
  description String?

  lignesBudget LigneBudgetPrevisionnel[]
  achats       AchatReel[]
}

model LigneBudgetPrevisionnel {
  id             String   @id @default(uuid())
  chantierId     String
  categorieId    String
  montantAlloue  Decimal  @db.Decimal(12, 2)
  heuresAllouees Decimal? @db.Decimal(10, 2)

  chantier  Chantier  @relation(fields: [chantierId], references: [id])
  categorie Categorie @relation(fields: [categorieId], references: [id])

  @@unique([chantierId, categorieId])
  @@index([categorieId])
}

model AchatReel {
  id   String   @id @default(uuid())
  date DateTime

  fournisseurId String
  fournisseur   Fournisseur @relation(fields: [fournisseurId], references: [id])
  numeroFacture String?

  description String
  montantHT   Decimal @db.Decimal(12, 2)

  chantierId String
  chantier   Chantier @relation(fields: [chantierId], references: [id])

  categorieId String
  categorie   Categorie @relation(fields: [categorieId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdById String
  createdBy   User @relation("AchatReelCreePar", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById String
  updatedBy   User @relation("AchatReelMisAJourPar", fields: [updatedById], references: [id], onDelete: Restrict)
  archivedAt DateTime?
  archivedById String?
  archivedBy   User? @relation("AchatReelArchivePar", fields: [archivedById], references: [id], onDelete: Restrict)
  motifArchivage String?

  @@index([archivedAt])
  @@index([fournisseurId])
  @@index([chantierId])
  @@index([categorieId])
}

model JournalSaisieChantier {
  id             String   @id @default(uuid())
  // Un journal couvre les écritures Travaux, les dossiers SAV et les contrats : un seul objet
  // append-only, mais une cible métier explicite et un seul parent renseigné à la fois.
  chantierId     String?
  interventionId String?
  contratMaintenanceId String?
  cible          String   // ACHAT | HEURE | INTERVENTION | INTERVENTION_RAPPORT | INTERVENTION_SIGNATURE | CONTRAT | CHANTIER (changement de client, de titulaire, de commercial ou de la case « Encaissé » de l’affaire)
  cibleId        String
  action         String   // CREATION | CORRECTION | ARCHIVAGE | RESTAURATION | CHANGEMENT_STATUT | CREATION_CONTRAT | SUSPENSION | REACTIVATION | CLOTURE | CHANGEMENT_CLIENT | CHANGEMENT_TITULAIRE | CHANGEMENT_COMMERCIAL | CHANGEMENT_ENCAISSEMENT
  // Toute nouvelle écriture a un compte auteur (contrainte CHECK en base, décision de Nelson du
  // 22-10-2026) : la génération automatique des visites écrit au nom du compte système, et seulement
  // la création de la visite d'un contrat ou l'avancement de son échéance. Vide pour les seules
  // écritures de cette génération faites avant #302, au nom « Génération automatique ».
  auteurId       String?
  auteur         User?    @relation("JournalSaisieChantierAuteur", fields: [auteurId], references: [id], onDelete: Restrict)
  // Nom figé à l'acte, lisible même si le compte est désactivé ultérieurement.
  auteurNom      String
  avant          Json?
  apres          Json?
  motif          String?
  createdAt      DateTime @default(now())

  @@index([chantierId, createdAt])
  @@index([interventionId, createdAt])
  @@index([contratMaintenanceId, createdAt])
  @@index([cible, cibleId, createdAt])
}

model Intervenant {
  id                String  @id @default(uuid())
  // Lien explicite au compte applicatif. Null pour les intervenants historiques/externe,
  // auxquels aucun accès Iris ne peut être attribué par déduction de nom.
  userId            String? @unique
  user              User?   @relation("IntervenantCompte", fields: [userId], references: [id], onDelete: SetNull)
  nom               String
  role              String
  tauxHoraireCharge Decimal @db.Decimal(10, 2)
  // Main d'œuvre (prix de vente) à laquelle l'intervenant est rattaché, facultative.
  rattachementMainOeuvre IntervenantMainOeuvre?

  pointages      PointageHeure[]
  coutsInterventionHeures CoutInterventionHeure[]
  planningEvents PlanningEvent[] @relation("PlanningEventIntervenants")
  affectationsIntervention InterventionAffectation[]
}

model PointageHeure {
  id                  String   @id @default(uuid())
  date                DateTime
  intervenantId       String
  chantierId          String
  nbrHeures           Decimal  @db.Decimal(10, 2)
  tauxHoraireApplique Decimal  @db.Decimal(10, 2)
  commentaire         String?

  intervenant Intervenant @relation(fields: [intervenantId], references: [id])
  chantier    Chantier    @relation(fields: [chantierId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdById String
  createdBy   User @relation("PointageHeureCreePar", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById String
  updatedBy   User @relation("PointageHeureMisAJourPar", fields: [updatedById], references: [id], onDelete: Restrict)
  archivedAt DateTime?
  archivedById String?
  archivedBy   User? @relation("PointageHeureArchivePar", fields: [archivedById], references: [id], onDelete: Restrict)
  motifArchivage String?

  @@index([archivedAt])
  @@index([intervenantId])
  @@index([chantierId])
}

// Heures SAV : celles d'une intervention de contrat et, depuis le lot pilote 3b, celles d'une
// intervention hors contrat. Séparées des coûts Chantier : elles n'alimentent ni le CA, ni les
// journaux d'achats et d'heures Travaux (/api/heures, /api/achats et leurs routes /api/v1). Seules
// celles d'une suite (intervention de suivi liée) rattachée à une affaire entrent, en totaux, dans la
// marge du chantier, donc aussi dans les métriques que /api/v1/chantiers transmet (décision de Nelson
// de la nuit du 26 au 27-10-2026, cf. src/domaines/chantiers/coutsSuites.ts).
model CoutInterventionHeure {
  id                  String       @id @default(uuid())
  interventionId      String
  intervention        Intervention @relation(fields: [interventionId], references: [id], onDelete: Restrict)
  intervenantId       String
  intervenant         Intervenant  @relation(fields: [intervenantId], references: [id], onDelete: Restrict)
  date                DateTime
  nbrHeures           Decimal      @db.Decimal(10, 2)
  tauxHoraireApplique Decimal      @db.Decimal(10, 2)
  // Prix de vente à l'heure hors contrat de la main d'œuvre de l'intervenant, copié le jour de la saisie
  // sur une intervention hors contrat, comme le taux horaire chargé, et figé en base (lot « marge d'un SAV
  // hors contrat », décisions de Nelson de la nuit du 26 au 27-10-2026, points 4 à 7, et du 27-10-2026 à
  // 10:27 UTC). Vide pour un intervenant sans main d'œuvre, pour une visite de contrat et pour une heure
  // saisie avant le lot : l'heure n'est alors pas valorisée dans la marge (interventions/margeSav.ts).
  prixVenteHoraireApplique Decimal? @db.Decimal(12, 2)
  commentaire         String?
  createdById         String
  createdBy           User         @relation("CoutInterventionHeureCreePar", fields: [createdById], references: [id], onDelete: Restrict)
  archivedAt          DateTime?
  archivedById        String?
  archivedBy          User?        @relation("CoutInterventionHeureArchivePar", fields: [archivedById], references: [id], onDelete: Restrict)
  motifArchivage      String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([interventionId, archivedAt])
  @@index([intervenantId])
}

model CoutInterventionAchat {
  id             String       @id @default(uuid())
  interventionId String
  intervention   Intervention @relation(fields: [interventionId], references: [id], onDelete: Restrict)
  fournisseurId  String
  fournisseur    Fournisseur  @relation(fields: [fournisseurId], references: [id], onDelete: Restrict)
  date           DateTime
  description    String
  montantHT      Decimal      @db.Decimal(12, 2)
  createdById    String
  createdBy      User         @relation("CoutInterventionAchatCreePar", fields: [createdById], references: [id], onDelete: Restrict)
  archivedAt     DateTime?
  archivedById   String?
  archivedBy     User?        @relation("CoutInterventionAchatArchivePar", fields: [archivedById], references: [id], onDelete: Restrict)
  motifArchivage String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([interventionId, archivedAt])
  @@index([fournisseurId])
}

// Paramètres globaux configurables par les administrateurs (singleton).
model Parametres {
  id                     String  @id @default("singleton")
  margeCommercialeActive Boolean @default(true) // affichage/calcul de la marge commerciale
  // Module Planning d'intervention : activé/désactivé globalement par un SUPERADMIN.
  // Désactivé, le module DISPARAÎT pour tous les autres comptes (y compris les
  // administrateurs) — menu masqué côté client, routes /api/planning/* refusées côté
  // serveur — mais AUCUNE donnée n'est supprimée : les affectations et types
  // d'événements restent en base et réapparaissent à la réactivation. Le superadmin, lui,
  // continue d'y accéder pour préparer/consulter le planning pendant la désactivation.
  planningActif          Boolean @default(true)
  // Taux d'acompte proposé par défaut à la création d'un devis, en pourcentage du TTC.
  // Comme les barèmes de rémunération, il vit en base et s'édite depuis l'administration :
  // changer la politique d'acompte d'une société ne doit jamais demander un redéploiement.
  // Le devis fige SA valeur à l'émission (cf. Devis.tauxAcompte) — modifier ce paramètre
  // n'a donc aucun effet rétroactif sur les devis déjà émis.
  tauxAcompteDefaut      Decimal @default(30) @db.Decimal(5, 2)
  // Alertes de suivi des chantiers, réglées par chaque société dans Administration > Marges.
  // Seuil en pourcentage du montant vendu, comparé à la marge ESTIMÉE en fin de chantier ;
  // vide (null), il est retiré mais une marge estimée négative reste signalée. Délai en jours
  // civils sans achat ni heure saisis ; vide (null), l'alerte « sans saisie » est désactivée.
  seuilMargeFaible       Decimal? @default(15) @db.Decimal(5, 2)
  joursSansSaisie        Int?     @default(14)
  // Destinataires du suivi de rentabilité d'un chantier — montant vendu global, marge du
  // jour, marge estimée, alertes « en perte » et « marge faible », facturation de la fiche —
  // partout où le chantier leur est montré (liste, tableau de bord, fiche). Les budgets par
  // poste restent visibles de tous ceux qui voient le chantier. Les administrateurs les
  // reçoivent toujours. Chaque catégorie se désactive pour s'adapter à l'organisation de la
  // société :
  //  - le conducteur (ou responsable) du chantier ;
  //  - la chaîne hiérarchique de ce conducteur, jusqu'au sommet (comptes Responsable) ;
  //  - les comptes Directeur, qui voient tous les chantiers.
  rentabiliteConducteur  Boolean  @default(true)
  rentabiliteHierarchie  Boolean  @default(true)
  rentabiliteDirecteurs  Boolean  @default(true)
  // Durée de conservation du journal des paramètres et des droits (JournalAdministration), en
  // jours. Décision de Nelson du 14-10-2026 : une durée conforme au RGPD, à faire valider par le
  // cabinet juridique ; à défaut, réglable, de 90 jours au plus (CHECK 1 à 90 en base). Réglée
  // par un super administrateur, et journalisée.
  journalConservationJours Int    @default(90)
  // Génération automatique des visites de maintenance (lot pilote 5) : chaque jour, la visite de
  // l'échéance d'un contrat actif est créée dès que l'échéance tombe dans ce nombre de jours
  // civils (0 : le jour même ; CHECK 0 à 365 en base). Vide (null), la génération automatique
  // est désactivée ; les actions manuelles des contrats restent possibles. Vide au démarrage :
  // la génération reste désactivée tant que la société ne l'a pas réglée (décision de Nelson du
  // 22-10-2026). Réglée par un administrateur, et journalisée.
  anticipationVisitesJours Int?
  // Pas du temps passé (lot « devis au temps passé », décisions de Nelson des 24 et 25-10-2026) : au-delà
  // de la première heure, le temps passé se facture par ce pas, en minutes, toujours arrondi au pas
  // supérieur. Vide au démarrage (décision du 25-10-2026, « Aucune, à régler ») : un devis au temps passé
  // est refusé tant que l'administration ne l'a pas fixé. Choix par défaut, à confirmer : un entier de 1
  // à 60 minutes (CHECK en base). Réglé par un administrateur, et journalisé. Chaque devis au temps passé
  // fige sa valeur (cf. Devis.pasTempsPasseMinutes). Depuis le lot « facture au temps passé » (décisions de
  // Nelson de la nuit du 26 au 27-10-2026, point 8), l'API n'accepte plus que 15, 30, 45 ou 60 minutes ;
  // la base garde les bornes de 1 à 60 pour une valeur réglée avant (aucune reprise, règle 4), qu'un
  // nouveau devis refuse de figer.
  pasTempsPasseMinutes     Int?
  // Temps minimum facturé d'un devis au temps passé (lot « facture au temps passé », décisions de Nelson
  // de la nuit du 26 au 27-10-2026, points 8 et 9) : en minutes, par multiples de 15, de 15 minutes à
  // 8 heures (CHECK en base) ; une heure à l'installation ; vidé, il revient à une heure. Réglé par un
  // administrateur, et journalisé. Chaque nouveau devis au temps passé fige sa valeur
  // (cf. Devis.tempsMinimumMinutes).
  tempsMinimumMinutes      Int      @default(60)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Journal des paramètres et des droits (lot (a), décision de Nelson du 13-10-2026) : tout
// changement de réglage de l'instance et tout changement de droits d'un compte, avec son auteur,
// la valeur avant et après. Consultable et exportable par les seuls administrateurs ; un simple
// administrateur ne voit ni les entrées qui concernent un compte super administrateur
// (concerneSuperAdmin), ni celles réservées au super administrateur (reserveSuperAdmin : clés
// d'intégration). En ajout seul : un trigger refuse toute modification, et toute suppression
// d'une entrée plus récente que la durée de conservation (Parametres.journalConservationJours).
// L'auteur n'a pas de clé étrangère : la suppression d'un compte ne bloque ni n'efface son
// historique, dont le nom est figé (auteurNom).
model JournalAdministration {
  id                 String   @id @default(uuid())
  domaine            String // DROITS | REGLAGES
  type               String // COMPTE | PARAMETRES | MODULES | REMUNERATION | PRIME_COMMERCIAL | SOCIETE | CLE_INTEGRATION | PARTAGE_PLANNING | CONSERVATION_JOURNAL | MAIN_OEUVRE | INTERVENANT
  action             String
  cibleId            String?
  cibleLibelle       String?
  avant              Json?
  apres              Json?
  detail             String?
  concerneSuperAdmin Boolean  @default(false)
  reserveSuperAdmin  Boolean  @default(false)
  auteurId           String?
  auteurNom          String
  auteurSuperAdmin   Boolean  @default(false)
  createdAt          DateTime @default(now())

  @@index([createdAt])
  @@index([type, createdAt])
}

// Identité unique de la société exploitant cette instance Iris. Chaque installation et
// sa base sont dédiées à une seule société : ce modèle singleton n'est pas multi-tenant.
model CompanySettings {
  id                String   @id @default("singleton")
  raisonSociale     String?
  nomCommercial     String?
  siret             String?
  tvaIntra          String?
  adresse           String?
  codePostal        String?
  ville             String?
  pays              String?  @default("France")
  telephone         String?
  email             String?
  siteWeb           String?
  logoUrl           String?
  // Logo imprimé sur les documents (lot 6a-1) : version téléversée, copiée avec l'identité à
  // l'émission d'une pièce. `logoUrl` reste lisible par l'API sans servir aux documents.
  logoDocumentId    String?
  logoDocument      LogoDocument? @relation(fields: [logoDocumentId], references: [id], onDelete: Restrict)
  couleurPrimaire   String?  @default("#1e3a8a")
  couleurSecondaire String?  @default("#f59e0b")
  prefixeFacture    String?
  // Préfixe légal dédié aux avoirs. Son absence utilise « A » sans réemployer la séquence facture.
  prefixeAvoir       String?
  piedFacture       String?
  // Fuseau civil de la société exploitant l'instance. Les dates-seules restent à minuit
  // UTC ; ce réglage sert uniquement aux instants et aux jours dérivés d'un instant.
  fuseauHoraire     String?  @default("Europe/Paris")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// Référentiel client natif Iris : aucune dépendance à un ERP ou un CRM tiers.
model Client {
  id                   String               @id @default(uuid())
  raisonSociale        String
  nomCommercial        String?
  siren                String?              @unique
  // Case « pas de SIRET » (lot 6a-2 bis) : un particulier, que l'on facture sans SIREN ; son nom
  // complet tient lieu de raison sociale. La base refuse un client « pas de SIRET » qui garde un SIREN.
  sansSiret            Boolean              @default(false)
  tvaIntra             String?
  telephone            String?
  email                String?
  actif                Boolean              @default(true)
  contacts             ClientContact[]
  sites                ClientSite[]
  equipementsInstalles EquipementInstalle[]
  devis                Devis[]
  interventions        Intervention[]
  contratsMaintenance  ContratMaintenance[]
  chantiers            Chantier[] @relation("ChantierClient")
  factures             Facture[]
  reglements           Reglement[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
}

// Devis natif versionné. Un dossier garde les révisions d'une même proposition ; une
// révision est immuable dès qu'elle est envoyée ou acceptée, la modification crée la suivante.
model Devis {
  id                 String       @id @default(uuid())
  dossierId          String
  numero             String
  version            Int
  clientId           String
  client             Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  objet              String
  statut             String       @default("BROUILLON")
  totalHt            Decimal      @db.Decimal(12, 2)
  totalTva           Decimal      @db.Decimal(12, 2)
  totalTtc           Decimal      @db.Decimal(12, 2)
  lignes             DevisLigne[]
  // Conversions de l'affaire (lot 4 suite) : au plus deux, de types différents, sur ce devis.
  conversions        DevisConversion[]
  signature          DevisSignature?
  // Envois préparés par la messagerie de l'utilisateur (lot 6a-3), en ajout seul.
  envois             EnvoiDocument[]

  // --- Acompte conditionnant l'ouverture du chantier ---
  // Coché sur le devis initial : tant que l'acompte n'est pas constaté, la conversion en
  // chantier est refusée. Le TAUX est figé ici à l'émission, à partir du paramètre global :
  // le modifier plus tard ne réécrit aucun devis déjà émis. Les trois champs de constatation
  // sont saisis à la main tant que le module paiements (phase 9) n'existe pas ; le
  // rapprochement bancaire les alimentera ensuite sans changer la règle.
  acompteExige         Boolean   @default(false)
  tauxAcompte          Decimal?  @db.Decimal(5, 2)
  acompteRecuLe        DateTime?
  acompteMontant       Decimal?  @db.Decimal(12, 2)
  acompteReference     String?
  acompteConstateParId String?

  // --- Devis au temps passé (décisions de Nelson des 24 et 25-10-2026) ---
  // Le marqueur distingue une intervention « au temps passé » ; il est reporté sur l'intervention à
  // la conversion. Un devis au temps passé porte exactement une ligne de main d'œuvre au temps passé
  // (DevisLigne.tempsPasse), un devis ordinaire aucune : garanti par l'API et, à la validation de
  // chaque transaction, par la base. Le pas du temps passé est copié du réglage de la société et figé
  // comme le taux d'acompte : à la création, au passage au temps passé, relu à la duplication, copié
  // par une révision ; vide sur un devis ordinaire.
  auTempsPasse         Boolean   @default(false)
  pasTempsPasseMinutes Int?
  // Temps minimum facturé, copié du réglage de la société et figé avec le pas (lot « facture au temps
  // passé ») : la ligne au temps passé vaut ce minimum, puis des multiples du pas. Vide sur un devis
  // ordinaire, et sur un devis au temps passé fait avant ce lot, qui garde la règle d'alors (une heure
  // minimum, son pas figé, quantité au millième) : aucune reprise (règle 4).
  tempsMinimumMinutes  Int?

  // --- Annulation, terminale ---
  // Un chantier ne se supprime plus : la seule façon de revenir sur une affaire ouverte par
  // erreur est d'annuler son devis, ce qui archive le chantier lié. Réservée aux
  // administrateurs, motif obligatoire, et refusée dès qu'une heure ou un achat a été saisi.
  // On n'annule pas une annulation : la reprise passe par une duplication.
  annuleLe             DateTime?
  annuleParId          String?
  motifAnnulation      String?

  // --- Duplication ---
  // Le devis neuf qui reprend un devis à l'identique, avec son propre numéro. Le lien vers
  // l'origine évite de retrouver deux devis jumeaux sans savoir que l'un remplace l'autre.
  origineDevisId       String?
  origineDevis         Devis?    @relation("DevisDuplication", fields: [origineDevisId], references: [id], onDelete: SetNull)
  duplicatas           Devis[]   @relation("DevisDuplication")

  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([dossierId, version])
  @@index([clientId])
  @@index([numero])
  @@index([origineDevisId])
}

model DevisLigne {
  id              String   @id @default(uuid())
  devisId         String
  devis           Devis    @relation(fields: [devisId], references: [id], onDelete: Cascade)
  ordre           Int
  designation     String
  nature          String   @default("MAIN_OEUVRE")
  quantite        Decimal  @db.Decimal(12, 3)
  prixUnitaireHt  Decimal  @db.Decimal(12, 2)
  tauxTva         Decimal  @db.Decimal(5, 2)
  totalHt         Decimal  @db.Decimal(12, 2)
  totalTtc        Decimal  @db.Decimal(12, 2)
  // Ligne reprise du catalogue (lot pilote 2, décision A8) : une COPIE, figée dans le devis.
  // La famille et l'identifiant ne servent qu'à la traçabilité ; la référence et l'unité
  // sont recopiées à l'ajout et ne suivent plus la fiche, modifiée ou désactivée ensuite.
  unite               String?
  reference           String?
  catalogueFamille    String?
  catalogueId         String?
  // Prix d'achat prévu, facultatif : donnée interne, réservée aux administrateurs, jamais
  // imprimée ni signée par le client (choix par défaut, à confirmer).
  prixAchatUnitaireHt Decimal? @db.Decimal(12, 2)
  // Ligne « main d'œuvre au temps passé » (décisions de Nelson du 25-10-2026, « À l'heure seulement »
  // et « Ligne minimum comptée ») : reprise d'une main d'œuvre active du catalogue, au prix à l'heure
  // hors contrat ou sous contrat (tarifTempsPasse : HORS_CONTRAT | SOUS_CONTRAT), fixé par le serveur
  // à son ajout puis figé ; une heure au moins, l'unité l'heure, comptée dans le total du devis. Une
  // contrainte CHECK et un index unique partiel (une seule par devis) la gardent en base.
  tempsPasse          Boolean  @default(false)
  tarifTempsPasse     String?
  // Heures prévues (lot « budget et heures prévues du chantier », réponses de Nelson du 30-10-2026) :
  // minutes prévues pour une unité de la ligne, copiées à son ajout comme la référence, puis figées. Une
  // prestation du catalogue qui n'est pas une main d'œuvre y porte sa durée indicative, 0 sans durée
  // (« Durée indicative ») ; un article ou un équipement, 0 (choix par défaut, à confirmer) ; vide, la
  // ligne compte sa quantité en heures (ligne saisie à la main, « Sa quantité » ; main d'œuvre à l'heure ;
  // ligne enregistrée avant ce lot, qui garde la règle d'avant).
  // En minutes, pour un compte exact : une durée en minutes ne s'écrit pas toujours en heures décimales.
  // Seule une ligne de main-d'œuvre compte des heures ; jamais imprimées ni signées.
  minutesPrevuesUnite Decimal? @db.Decimal(12, 2)
  // Ligne de main d'œuvre au jour ou à la demi-journée (troisième PR du lot, réponse de Nelson du
  // 30-10-2026, « Option de la main d'œuvre ») : reprise d'une main d'œuvre active du catalogue au forfait
  // (forfaitMainOeuvre : JOUR | DEMI_JOURNEE) et au tarif choisis (tarifForfait : HORS_CONTRAT |
  // SOUS_CONTRAT), au prix fixé par le serveur depuis la fiche (forfait jour, ou prix de la demi-journée,
  // « Prix à part ») puis figé, l'unité « jour » ou « demi-journée », une quantité entière, au moins 1 (choix
  // par défaut, à confirmer), et pour minutes prévues par unité les heures par jour de la main d'œuvre × 60,
  // ou × 30 (point 16 de la nuit du 26 au 27-10-2026). Tous deux
  // vides sur une autre ligne ; une contrainte CHECK les lie. Le PDF n'en imprime que l'unité ; le contenu
  // signé les porte quand ils sont renseignés.
  forfaitMainOeuvre   String?
  tarifForfait        String?

  @@unique([devisId, ordre])
}

// Attestation interne : elle associe l'identité déclarée du signataire à un instant et à
// l'empreinte SHA-256 d'un contenu de devis déterministe. Ce n'est pas une signature qualifiée.
model DevisSignature {
  id               String   @id @default(uuid())
  devisId          String   @unique
  // Une signature est une preuve : ni le devis ni l'auteur humain ne peuvent disparaître.
  devis            Devis    @relation(fields: [devisId], references: [id], onDelete: Restrict)
  enregistreParId  String
  enregistrePar    User     @relation("DevisSignatureEnregistreePar", fields: [enregistreParId], references: [id], onDelete: Restrict)
  signataire       String
  empreinte        String
  signeLe          DateTime @default(now())
  // Copies prises à la signature (lot 6a-2) : le PDF d'un devis signé ne lit aucune donnée
  // vivante. Absentes des signatures antérieures ; exigées en base pour les nouvelles.
  identiteEmetteurId  String?
  identiteEmetteur    IdentiteEmetteur? @relation(fields: [identiteEmetteurId], references: [id], onDelete: Restrict)
  clientRaisonSociale String?
  clientAdresse       String?
  // Fuseau de la société à la signature : il date le devis signé imprimé (création, signature).
  fuseauHoraire       String?

  @@index([enregistreParId])
  @@index([identiteEmetteurId])
}

// Conversion irréversible et traçable d’un devis accepté en chantier, intervention ou contrat
// de maintenance. Depuis le lot 4 suite (décisions de Nelson des 22 et 23-10-2026), une affaire
// (dossier) se convertit au plus deux fois, en deux cibles de types différents, toutes deux depuis
// le même devis : un type par dossier et par devis (contraintes uniques), et un rang 1 ou 2
// unique par dossier, que la base borne (CHECK de la migration 20261023230000).
model DevisConversion {
  id        String   @id @default(uuid())
  devisId   String
  dossierId String
  devis     Devis    @relation(fields: [devisId], references: [id], onDelete: Restrict)
  cibleType String   // CHANTIER | INTERVENTION | CONTRAT
  cibleId   String
  // Rang de la conversion dans son affaire : 1, puis 2. Une ligne écrite sans rang prend le rang 1,
  // qu'une seconde conversion du dossier ne peut plus prendre.
  rang      Int      @default(1)
  createdAt DateTime @default(now())

  @@unique([devisId, cibleType])
  @@unique([dossierId, cibleType])
  @@unique([dossierId, rang])
  @@index([cibleType, cibleId])
}

// Facture française native : les montants et lignes sont figés dès l'émission. Le numéro
// légal est volontairement attribué à l'émission, jamais à un brouillon abandonné.
model Facture {
  id            String         @id @default(uuid())
  numero        String?        @unique
  annee         Int?
  clientId      String
  client        Client         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  // Identité figée à la création : renommer la fiche client ne réécrit jamais une facture émise.
  clientRaisonSociale String
  // Adresse de facturation figée à l'émission : mention obligatoire du document français.
  clientAdresse       String?
  statut        String         @default("BROUILLON") // BROUILLON | EMISE | REGLEE | ANNULEE
  // FACTURE et AVOIR portent des montants positifs ; leur sens comptable est déterminé par ce type.
  type          String         @default("FACTURE") // FACTURE | AVOIR
  // Un avoir peut être partiel : plusieurs avoirs partagent alors la même facture source.
  // Le garde SQL `Facture_un_avoir_annulation_par_origine` maintient l’unicité du seul avoir total.
  factureOrigineId      String?
  factureOrigine        Facture?  @relation("FactureAvoir", fields: [factureOrigineId], references: [id], onDelete: Restrict)
  avoirs                Facture[] @relation("FactureAvoir")
  estAvoirAnnulation    Boolean   @default(false)
  dateEmission  DateTime
  dateEcheance  DateTime
  totalHt       Decimal        @db.Decimal(12, 2)
  totalTva      Decimal        @db.Decimal(12, 2)
  totalTtc      Decimal        @db.Decimal(12, 2)
  // Une facture porte toujours une origine explicite : affaire, SAV, contrat ou exception motivée.
  origine              String
  chantierId           String?
  chantier             Chantier? @relation("FactureChantier", fields: [chantierId], references: [id], onDelete: Restrict)
  interventionId       String?
  intervention         Intervention? @relation("FactureIntervention", fields: [interventionId], references: [id], onDelete: Restrict)
  contratMaintenanceId String?
  contratMaintenance   ContratMaintenance? @relation("FactureContratMaintenance", fields: [contratMaintenanceId], references: [id], onDelete: Restrict)
  motifHorsAffaire     String?
  // Facture au temps passé (lot « facture au temps passé », seconde PR) : ses lignes reprennent le devis
  // de l'intervention, la ligne au temps passé valant les heures saisies sur l'intervention et ses suites,
  // arrondies au pas au-delà du minimum figé, avec au moins ce minimum. Posée à la création et figée ;
  // une seule facture vivante par intervention (gardes de la migration 20261028180000_facture_temps_passe).
  tempsPasse           Boolean   @default(false)
  mentionsLegalesVersionId String?
  mentionsLegalesVersion   MentionsLegalesVersion? @relation(fields: [mentionsLegalesVersionId], references: [id], onDelete: Restrict)
  // Identité de l'émetteur copiée à l'émission (lot 6a-1, décision 6) ; absente des pièces
  // émises avant ce lot, qui gardent leur impression d'origine.
  identiteEmetteurId String?
  identiteEmetteur   IdentiteEmetteur? @relation(fields: [identiteEmetteurId], references: [id], onDelete: Restrict)
  lignes        FactureLigne[]
  // Ventilation par taux figée à la création des nouveaux documents. Les factures
  // historiques restent lisibles sans ligne de ventilation et utilisent le fallback dérivé.
  ventilationTva FactureVentilationTva[]
  ecrituresComptables EcritureFacture[]
  ecrituresScellees Boolean @default(false)
  journal       JournalFacture[]
  affectationsReglement AffectationReglement[]
  // Envois préparés par la messagerie de l'utilisateur (lot 6a-3), en ajout seul.
  envois        EnvoiDocument[]
  createdById   String?
  emisLe        DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([factureOrigineId])
  @@index([clientId, statut])
  @@index([type, statut])
  @@index([statut, dateEcheance])
  @@index([chantierId])
  @@index([interventionId])
  @@index([contratMaintenanceId])
  @@index([mentionsLegalesVersionId])
  @@index([identiteEmetteurId])
}

// Règlement client saisi à la main (décision A3 du 16-10-2026) : la banque viendra plus tard.
// Il est entièrement affecté à des factures émises du même client, et n'est jamais modifié
// ni supprimé : une saisie erronée est contre-passée, avec motif et auteur. Les gardes SQL de
// la migration `20261016120000_reglements` portent ces invariants hors de l'API.
model Reglement {
  id                   String                 @id @default(uuid())
  clientId             String
  client               Client                 @relation(fields: [clientId], references: [id], onDelete: Restrict)
  // Date civile du règlement, stockée à minuit UTC comme les dates de facture.
  dateReglement        DateTime
  montant              Decimal                @db.Decimal(12, 2)
  moyen                String // VIREMENT | CHEQUE | CARTE | PRELEVEMENT | ESPECES
  reference            String?
  statut               String                 @default("ENREGISTRE") // ENREGISTRE | CONTREPASSE
  motifContrepassation String?
  contrepasseLe        DateTime?
  contrepasseParId     String?
  contrepassePar       User?                  @relation("ReglementContrepassation", fields: [contrepasseParId], references: [id], onDelete: Restrict)
  createdById          String
  createdBy            User                   @relation("ReglementAuteur", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt            DateTime               @default(now())
  affectations         AffectationReglement[]

  @@index([clientId, dateReglement])
  @@index([dateReglement, createdAt])
}

// Part d'un règlement imputée à une facture. Une contre-passation retire toutes les parts du
// règlement du calcul du reste dû, sans effacer la ligne.
model AffectationReglement {
  id          String    @id @default(uuid())
  reglementId String
  reglement   Reglement @relation(fields: [reglementId], references: [id], onDelete: Restrict)
  factureId   String
  facture     Facture   @relation(fields: [factureId], references: [id], onDelete: Restrict)
  montant     Decimal   @db.Decimal(12, 2)

  @@unique([reglementId, factureId])
  @@index([factureId])
}

model EcritureFacture {
  id          String  @id @default(uuid())
  factureId   String
  facture     Facture @relation(fields: [factureId], references: [id], onDelete: Restrict)
  ordre       Int
  cle         String
  tauxTva     Decimal? @db.Decimal(5, 2)
  journalCode String
  compteNum   String
  compteLib   String
  debit       Decimal @db.Decimal(12, 2)
  credit      Decimal @db.Decimal(12, 2)

  @@unique([factureId, ordre])
  @@index([factureId])
}

// Journal des envois d'un document (lots 6a-3 et 6a-4d, choix par défaut, à confirmer) : chaque envoi
// préparé depuis Iris, aujourd'hui par la messagerie de l'utilisateur (lien mailto, PDF joint à la
// main). Iris ne sait pas si le courriel est parti : une ligne dit qu'un envoi a été préparé, à qui,
// sous quel objet et par qui. En ajout seul, garanti en base (migration 20261023120000) : ni
// modification, ni suppression, ni vidage ; horodatage imposé par la base. Exactement un document :
// devis ou facture (avoir compris), depuis le lot 6a-3 ; compte rendu d'une intervention ou contrat
// de maintenance, depuis le lot 6a-4d (migration 20261031120000). Le canal MICROSOFT_365 viendra avec
// le lot 6b.
model EnvoiDocument {
  id                   String              @id @default(uuid())
  devisId              String?
  devis                Devis?              @relation(fields: [devisId], references: [id], onDelete: Restrict)
  factureId            String?
  facture              Facture?            @relation(fields: [factureId], references: [id], onDelete: Restrict)
  // Compte rendu d'une intervention : un seul PDF par intervention, avec tous ses comptes rendus.
  interventionId       String?
  intervention         Intervention?       @relation(fields: [interventionId], references: [id], onDelete: Restrict)
  contratMaintenanceId String?
  contratMaintenance   ContratMaintenance? @relation(fields: [contratMaintenanceId], references: [id], onDelete: Restrict)
  canal                String // MESSAGERIE
  destinataire         String
  objet                String
  // Compte qui a préparé l'envoi, sans clé étrangère (comme JournalFacture.acteurId), et son nom
  // copié à l'enregistrement : le journal se lit même si le compte est renommé ou supprimé.
  auteurId             String
  auteurNom            String
  createdAt            DateTime            @default(now()) @db.Timestamptz(3)

  @@index([devisId, createdAt])
  @@index([factureId, createdAt])
  @@index([interventionId, createdAt])
  @@index([contratMaintenanceId, createdAt])
}

model JournalFacture {
  id        String   @id @default(uuid())
  factureId String
  facture   Facture  @relation(fields: [factureId], references: [id], onDelete: Restrict)
  acteurId  String?
  action    String
  detail    String?
  createdAt DateTime @default(now())

  @@index([factureId, createdAt])
}

model FactureLigne {
  id             String  @id @default(uuid())
  factureId      String
  facture        Facture @relation(fields: [factureId], references: [id], onDelete: Restrict)
  ordre          Int
  designation      String
  nature           String   @default("PRESTATION") // PRESTATION | ARTICLE : ventilation comptable configurable
  quantite       Decimal @db.Decimal(12, 3)
  prixUnitaireHt Decimal @db.Decimal(12, 2)
  tauxTva        Decimal @db.Decimal(5, 2)
  totalHt        Decimal @db.Decimal(12, 2)
  totalTtc       Decimal @db.Decimal(12, 2)

  @@unique([factureId, ordre])
}

model FactureVentilationTva {
  id        String   @id @default(uuid())
  factureId String
  facture   Facture  @relation(fields: [factureId], references: [id], onDelete: Cascade)
  tauxTva   Decimal  @db.Decimal(5, 2)
  totalHt   Decimal  @db.Decimal(12, 2)
  totalTva  Decimal  @db.Decimal(12, 2)
  totalTtc  Decimal  @db.Decimal(12, 2)

  @@unique([factureId, tauxTva])
  @@index([factureId])
}

model MentionsLegalesVersion {
  id        String    @id @default(uuid())
  version   Int       @unique
  mentions  String
  cgv       String
  penalites String
  escompte  String?
  actif     Boolean   @default(false)
  publieeLe DateTime?
  createdAt DateTime  @default(now())
  factures  Facture[]
}

// Logo des documents : une version téléversée ne change jamais (garde SQL), et l'empreinte
// SHA-256 de son contenu évite de stocker deux fois le même fichier.
model LogoDocument {
  id        String   @id @default(uuid())
  contenu   Bytes
  typeMime  String   // image/png | image/jpeg
  empreinte String   @unique
  taille    Int
  createdAt DateTime @default(now())
  societes  CompanySettings[]
  identites IdentiteEmetteur[]
}

// Identité de l'émetteur telle qu'imprimée sur une pièce, copiée à son émission (décision 6 de
// la proposition de paramétrage). Une ligne ne change jamais (garde SQL) ; les pièces émises avec
// la même identité partagent la même ligne, retrouvée par l'empreinte de son contenu.
model IdentiteEmetteur {
  id              String   @id @default(uuid())
  empreinte       String   @unique
  raisonSociale   String
  nomCommercial   String?
  siret           String
  tvaIntra        String?
  adresse         String
  codePostal      String
  ville           String
  pays            String?
  telephone       String?
  email           String?
  siteWeb         String?
  piedDocument    String?
  couleurPrimaire String
  logoId          String?
  logo            LogoDocument? @relation(fields: [logoId], references: [id], onDelete: Restrict)
  createdAt       DateTime @default(now())
  factures        Facture[]
  signaturesDevis DevisSignature[]

  @@index([logoId])
}

model SequenceFacture {
  annee         Int @id
  dernierNumero Int @default(0)
}

// Les avoirs ont une séquence autonome : un avoir ne consomme jamais un numéro de facture.
model SequenceAvoir {
  annee         Int @id
  dernierNumero Int @default(0)
}

// Référentiel comptable par instance : il démarre vide et se paramètre/importera selon le cabinet.
model CompteComptable {
  id        String  @id @default(uuid())
  code      String  @unique
  libelle   String
  nature    String  // ACTIF | PASSIF | PRODUIT | CHARGE | TVA
  actif     Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  regles    RegleComptable[]
  reglesTva RegleTvaComptable[]
  journal   JournalCompteComptable[]
}

model JournalCompteComptable {
  id        String @id @default(uuid())
  compteId  String
  compte    CompteComptable @relation(fields: [compteId], references: [id], onDelete: Restrict)
  auteurId  String
  auteur    User @relation(fields: [auteurId], references: [id], onDelete: Restrict)
  auteurNom String
  action    String // DESACTIVATION | REACTIVATION | MODIFICATION
  avant     Boolean?
  apres     Boolean?
  avantLibelle String?
  apresLibelle String?
  avantNature String?
  apresNature String?
  motif     String
  createdAt DateTime @default(now())

  @@index([compteId, createdAt])
  @@index([auteurId])
}

model RegleComptable {
  id        String           @id @default(uuid())
  cle       String           @unique // CLIENT | TVA_COLLECTEE | VENTE_PRESTATION | VENTE_ARTICLE | JOURNAL_VENTES
  compteId  String?
  compte    CompteComptable? @relation(fields: [compteId], references: [id], onDelete: Restrict)
  journal   String?
  updatedAt DateTime         @updatedAt

  @@index([compteId])
}

model JournalRegleComptable {
  id        String   @id @default(uuid())
  type      String   // REGLE | TVA
  cible     String   // clé de règle ou taux canonique
  action    String   // CREATION | REMAPPAGE | RETRAIT
  avant     String?
  apres     String?
  avantCode String?
  avantLibelle String?
  apresCode String?
  apresLibelle String?
  motif     String
  auteurId  String
  auteur    User     @relation(fields: [auteurId], references: [id], onDelete: Restrict)
  auteurNom String
  createdAt DateTime @default(now())

  @@index([type, cible, createdAt])
  @@index([auteurId])
}

model TransitionRegleComptable {
  // Ledger interne des transitions : la cardinalité empêche la réutilisation d'une preuve.
  id            BigInt @id @default(autoincrement())
  transactionId BigInt
  type          String
  cible         String
  action        String
  avant         String?
  apres         String?

  @@index([transactionId])
}

// Une TVA est ventilée par taux : indispensable à la déclaration CA3.
model RegleTvaComptable {
  id       String           @id @default(uuid())
  taux     Decimal          @unique @db.Decimal(5, 2)
  compteId String
  compte   CompteComptable  @relation(fields: [compteId], references: [id], onDelete: Restrict)
  updatedAt DateTime        @updatedAt

  @@index([compteId])
}

// Passages de la génération des visites de maintenance (lot pilote 5). Un passage automatique au
// plus par jour civil de la société : cleJourAutomatique (« AAAA-MM-JJ », unique) n'est
// renseignée que pour eux (CHECK en base). Les passages lancés à la main par un administrateur
// ne sont pas limités. Chaque contrat est traité dans sa propre transaction : un contrat en échec
// est consigné dans `erreurs` sans empêcher les autres ; `contratsIgnores` liste les contrats
// laissés de côté pour une raison métier (client désactivé, visite de l'échéance annulée).
model ExecutionGenerationVisites {
  id                 String    @id @default(uuid())
  jour               DateTime  @db.Date
  declenchement      String    // AUTOMATIQUE | MANUEL
  cleJourAutomatique String?   @unique
  // Administrateur qui a lancé un passage manuel ; compte système pour un passage automatique (vide
  // pour les seuls passages automatiques enregistrés avant #302).
  auteurId           String?
  auteurNom          String?
  anticipationJours  Int
  debut              DateTime  @default(now())
  fin                DateTime?
  statut             String    @default("EN_COURS") // EN_COURS | REUSSIE | ECHEC
  visitesCreees      Int       @default(0)
  echeancesAvancees  Int       @default(0)
  contratsIgnores    Json      @default("[]")
  erreurs            Json      @default("[]")

  @@index([debut])
}

// Contrat de maintenance natif : son échéance est un engagement métier, distinct du planning.
// Les interventions générées y seront rattachées afin de garantir l'idempotence du cycle.
model ContratMaintenance {
  id                          String      @id @default(uuid())
  clientId                    String
  client                      Client      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  siteId                      String?
  site                        ClientSite? @relation(fields: [siteId], references: [id], onDelete: Restrict)
  titre                       String
  statut                      String      @default("ACTIF") // BROUILLON | ACTIF | SUSPENDU | TERMINE | ANNULE
  periodiciteMois             Int
  dureePrevisionnelleMinutes  Int
  dateDebut                   DateTime
  prochaineEcheance           DateTime
  // Politique qualitative du contrat : aucun prix, taux ou mécanisme de facturation.
  politiqueMainOeuvre         String      @default("HORS_FORFAIT") // INCLUSE | HORS_FORFAIT
  politiqueMateriel           String      @default("HORS_FORFAIT") // INCLUS | HORS_FORFAIT
  noteCouverture              String?
  // Annulation avec le devis dont le contrat est issu (lot 4 suite, décision de Nelson du
  // 23-10-2026) : terminale, même pour un contrat commencé. La date, l'auteur et le motif (celui
  // de l'annulation du devis) sont exigés avec le statut ANNULE, et un contrat annulé ne se
  // modifie plus (contrainte et trigger de la migration 20261023230000).
  annuleLe                    DateTime?
  annuleParId                 String?
  motifAnnulation             String?
  createdById                 String?
  createdAt                   DateTime    @default(now())
  updatedAt                   DateTime    @updatedAt
  interventions               Intervention[]
  factures                    Facture[] @relation("FactureContratMaintenance")
  envois                      EnvoiDocument[]

  @@index([clientId, statut])
  @@index([siteId])
  @@index([statut, prochaineEcheance])
}

// Compteur annuel atomique des références d'intervention : I26-0001, I26-0002…
model SequenceIntervention {
  annee         Int @id
  dernierNumero Int @default(0)
}

// Dossier SAV natif. Le planning reste une projection prévisionnelle : il ne remplace pas
// l'intervention, son client, son statut ni sa trace métier.
model Intervention {
  id             String   @id @default(uuid())
  reference      String   @unique
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  siteId         String?
  site           ClientSite? @relation("InterventionSite", fields: [siteId], references: [id], onDelete: Restrict)
  contactId      String?
  contact        ClientContact? @relation("InterventionContact", fields: [contactId], references: [id], onDelete: Restrict)
  chantierId     String?
  chantier       Chantier? @relation(fields: [chantierId], references: [id], onDelete: Restrict)
  contratMaintenanceId String?
  contratMaintenance   ContratMaintenance? @relation(fields: [contratMaintenanceId], references: [id], onDelete: Restrict)
  echeanceContrat      DateTime?
  // Instantané de la politique du contrat lors de la génération. Absent hors contrat,
  // et jamais réécrit lors d'une modification future du contrat.
  couvertureContrat    Json?
  titre          String
  description    String?
  priorite       String   @default("NORMALE") // BASSE | NORMALE | HAUTE | URGENTE
  statut         String   @default("A_PLANIFIER") // A_PLANIFIER | PLANIFIEE | EN_COURS | TERMINEE | ANNULEE
  dateSouhaitee  DateTime?
  // Jour de réception de la demande (date seule) ; NULL uniquement pour l'historique.
  dateDemande    DateTime? @db.Date
  // Intervention « au temps passé » : marqueur reporté depuis son devis à la conversion (décision de
  // Nelson du 25-10-2026, « Lot suivant ») ; la facture au temps passé viendra avec un lot suivant. Il ne
  // change plus ensuite, et la base n'accepte un marqueur vrai que d'une conversion d'un devis au temps
  // passé (gardes de la migration 20261025120000_devis_temps_passe).
  auTempsPasse   Boolean  @default(false)
  // Intervention de suivi liée (décisions de Nelson des 24 et 26-10-2026) : marque « à suivre », posée en
  // terminant (une intervention terminée seulement), qui disparaît une fois la suite créée ; lien d'une
  // suite vers l'intervention initiale, posé à sa création puis figé (gardes de la migration
  // 20261026120000_intervention_suivi). Une intervention peut avoir plusieurs suites.
  aSuivre                Boolean  @default(false)
  interventionInitialeId String?
  interventionInitiale   Intervention?  @relation("SuiteIntervention", fields: [interventionInitialeId], references: [id], onDelete: NoAction)
  suites                 Intervention[] @relation("SuiteIntervention")
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  affectations   InterventionAffectation[]
  rapports       InterventionRapport[]
  coutsHeures    CoutInterventionHeure[]
  coutsAchats    CoutInterventionAchat[]
  planningEvent  PlanningEvent?
  factures       Facture[] @relation("FactureIntervention")
  envois         EnvoiDocument[]

  @@index([clientId, statut])
  @@index([siteId])
  @@index([contactId])
  @@index([chantierId])
  @@index([contratMaintenanceId])
  @@index([interventionInitialeId])
  @@unique([contratMaintenanceId, echeanceContrat])
  @@index([statut, dateSouhaitee])
}

// Affectation explicite, jamais déduite d'un nom : c'est la clé de cloisonnement du
// parcours technicien et la future source des projections dans le planning.
model InterventionAffectation {
  id              String       @id @default(uuid())
  interventionId  String
  intervenantId   String
  intervention    Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)
  intervenant     Intervenant  @relation(fields: [intervenantId], references: [id], onDelete: Restrict)
  createdAt       DateTime     @default(now())

  @@unique([interventionId, intervenantId])
  @@index([intervenantId])
}

// Compte rendu terrain en ajout seul : une intervention garde ses constats tels qu'ils ont été
// saisis, avec leur auteur et leur date. Les corrections futures créent une nouvelle trace. Figé en
// base (#223) : ni modification, ni suppression, ni vidage ; une intervention qui en porte un ne se
// supprime pas.
model InterventionRapport {
  id             String       @id @default(uuid())
  interventionId String
  intervention   Intervention @relation(fields: [interventionId], references: [id], onDelete: Restrict)
  auteurId       String
  auteur         User         @relation(fields: [auteurId], references: [id], onDelete: Restrict)
  contenu        String
  // Clé d'envoi tirée par le formulaire à son ouverture (lot 3b-3) : un envoi répété après une
  // réponse perdue retrouve le compte rendu déjà enregistré au lieu d'en figer un second. Absente
  // des comptes rendus antérieurs.
  cleEnvoi       String?      @unique @db.Uuid
  signature      InterventionSignature?
  // Horodatage imposé par la base à l'insertion (lot 3b-3).
  createdAt      DateTime     @default(now())

  @@index([interventionId, createdAt])
  @@index([auteurId])
}

// Attestation électronique client d'un compte rendu : consentement explicite, signataire, tracé
// dessiné au doigt, compte qui l'enregistre, horodatage et empreinte SHA-256 du contenu figé et du
// tracé. Figée en base dès sa création (#223) : ni modification, ni suppression, ni vidage.
model InterventionSignature {
  id              String              @id @default(uuid())
  rapportId       String              @unique
  rapport         InterventionRapport @relation(fields: [rapportId], references: [id], onDelete: Restrict)
  signataire      String
  // Tracé vectoriel (décision de Nelson du 19-10-2026) : { ratio, traits: [[[x, y], …], …] },
  // coordonnées normalisées entre 0 et 1, sans horodatage ni pression ; borné par l'API.
  trace           Json
  enregistreParId String
  enregistrePar   User                @relation("InterventionSignatureEnregistreePar", fields: [enregistreParId], references: [id], onDelete: Restrict)
  empreinte       String
  // Horodatages imposés par la base à l'insertion (lot 3b-3).
  accepteLe       DateTime            @default(now())
  createdAt       DateTime            @default(now())

  @@index([accepteLe])
  @@index([enregistreParId])
}

// Compteur annuel atomique des références d'affaires : A26-0001, A26-0002…
model SequenceAffaire {
  annee         Int @id
  dernierNumero Int @default(0)
}

// Contact métier d'un client : peut être associé ultérieurement aux interventions,
// devis, contrats et factures sans confondre personne et adresse de site.
model ClientContact {
  id               String   @id @default(uuid())
  clientId         String
  client           Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  prenom           String?
  nom              String
  fonction         String?
  email            String?
  telephone        String?
  principal        Boolean  @default(false)
  estDecisionnaire Boolean  @default(false)
  estSignataire    Boolean  @default(false)
  interventions    Intervention[] @relation("InterventionContact")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([clientId])
}

// Un client possède plusieurs sites. PostgreSQL garantit via des index partiels
// qu'il n'existe au plus qu'un siège social et une adresse de facturation par client.
// L'interface impose leur sélection avant d'autoriser devis et factures.
model ClientSite {
  id                   String               @id @default(uuid())
  clientId             String
  client               Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  nom                  String
  adresse              String
  complementAdresse    String?
  codePostal           String
  ville                String
  pays                 String               @default("France")
  estSiegeSocial       Boolean              @default(false)
  estSiteFacturation   Boolean              @default(false)
  estSiteIntervention  Boolean              @default(false)
  principal            Boolean              @default(false)
  interventions        Intervention[]       @relation("InterventionSite")
  contratsMaintenance  ContratMaintenance[]
  equipementsInstalles EquipementInstalle[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([clientId])
}

// Règles de rémunération commerciale (singleton), sorties du code pour être éditables par
// la direction sans redéploiement — et pour qu'Iris ne porte plus dans ses sources les
// barèmes d'une société en particulier. Une nouvelle instance démarre sur les valeurs par
// défaut ci-dessous et les ajuste depuis Administration > Rémunération commerciale.
// Depuis la décision du 17-10-2026, ces règles générales ne sont plus appliquées : sans plan
// commercial, aucune commission ni prime.
//
// Les barèmes sont stockés en JSON : un tableau de tranches, chacune { plafond, taux }.
// `plafond: null` marque la DERNIÈRE tranche, celle qui n'est pas plafonnée (JSON ne sait
// pas représenter Infinity). Le barème est progressif, comme l'impôt sur le revenu :
// franchir un plafond ne requalifie que la fraction qui le dépasse.
model ParametresRemuneration {
  id String @id @default("singleton")

  // Barème appliqué par défaut à la marge mensuelle d'un commercial.
  baremeStandard Json
  // Barème appliqué aux chantiers cochés « barème réduit » (cf. Chantier.baremeReduit) :
  // affaires apportées par la société plutôt que par le commercial. Son libellé est
  // configurable : l'application n'en connaît aucun en dur.
  baremeReduit        Json
  libelleBaremeReduit String @default("Barème réduit")

  // Primes d'objectifs mensuels : versées quand le seuil du mois est atteint.
  objectifCaMensuel      Decimal @default(0) @db.Decimal(12, 2)
  primeObjectifCa        Decimal @default(0) @db.Decimal(12, 2)
  objectifMargeMensuel   Decimal @default(0) @db.Decimal(12, 2)
  primeObjectifMarge     Decimal @default(0) @db.Decimal(12, 2)
  // Prime « suivi administratif » : validée à la main, mois par mois, par un
  // administrateur (cf. PrimeMensuelleCommercial) — elle ne se déduit d'aucune donnée.
  primeSuiviAdministratif Decimal @default(0) @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Partage public en lecture seule du planning d'intervention (singleton) — lien de type
// "OneDrive" destiné aux techniciens, qui n'ont pas de compte dans l'application : un
// token opaque donne accès, SANS authentification, à GET /api/planning/public/:token.
// Le lien ne change qu'à la régénération volontaire du token par un administrateur
// (bouton "Renouveler le lien") ; `active` permet de couper l'accès sans en générer un
// nouveau (bouton "Désactiver le partage"), en conservant le même token pour une
// réactivation ultérieure.
// Clé machine-à-machine pour intégrations contrôlées (Hermes, connecteurs). Le secret
// n'est jamais stocké : seule son empreinte SHA-256 est persistée et la valeur n'est
// révélée qu'une fois à sa création par un SUPERADMIN.
model ApiAccessKey {
  id             String    @id @default(uuid())
  nom            String
  prefixe        String    @unique
  secretHash     String    @unique
  scopes         String[]
  actif          Boolean   @default(true)
  expireLe       DateTime?
  dernierUsageLe DateTime?
  creeParId      String
  creeLe         DateTime  @default(now())
  revoqueLe      DateTime?

  @@index([actif])
}

// Catégories libres et hiérarchiques, communes à tout le catalogue. Elles permettent
// d'organiser le métier sans imposer de nomenclature Iris (ex. Alarme > Détecteurs).
model CatalogueCategorie {
  id          String                @id @default(uuid())
  nom         String                @unique
  description String?
  parentId    String?
  parent      CatalogueCategorie?   @relation("CatalogueCategorieHierarchy", fields: [parentId], references: [id])
  enfants     CatalogueCategorie[]  @relation("CatalogueCategorieHierarchy")
  prestations CataloguePrestation[]
  articles    CatalogueArticle[]
  equipements CatalogueEquipement[]
  actif       Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([parentId])
}

// Catalogue natif : les prestations ne portent pas de stock ni de numéro de série.
model CataloguePrestation {
  id                 String              @id @default(uuid())
  categorieId        String?
  categorie          CatalogueCategorie? @relation(fields: [categorieId], references: [id])
  reference          String              @unique
  nom                String
  description        String?
  unite              String              @default("unité")
  dureeIndicativeMin Int?
  tauxTva            Decimal             @default(20) @db.Decimal(5, 2)
  // Prix d'achat facultatif (sous-traitance par exemple), repris comme prix d'achat prévu
  // d'une ligne de devis.
  prixAchatHt        Decimal?            @db.Decimal(12, 2)
  prixVenteHt        Decimal             @default(0) @db.Decimal(12, 2)
  actif              Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  // Main d'œuvre au catalogue (décisions de Nelson du 24-10-2026) : une prestation par main
  // d'œuvre, avec quatre PRIX DE VENTE, jamais des coûts (le coût reste le taux horaire chargé de
  // l'intervenant). Choix par défaut, à confirmer : `prixVenteHt` est le prix à l'heure hors
  // contrat, l'unité l'heure ; s'y ajoutent le forfait jour hors contrat, l'heure et le forfait
  // jour sous contrat, et le nombre d'heures d'une journée (décision « Par main d'œuvre »). Une
  // contrainte CHECK exige ces champs d'une main d'œuvre et les interdit à une autre prestation.
  estMainOeuvre             Boolean                 @default(false)
  prixJourHorsContratHt     Decimal?                @db.Decimal(12, 2)
  prixHeureSousContratHt    Decimal?                @db.Decimal(12, 2)
  prixJourSousContratHt     Decimal?                @db.Decimal(12, 2)
  heuresParJour             Decimal?                @db.Decimal(4, 2)
  // Prix de la demi-journée (lot « budget et heures prévues du chantier », réponse de Nelson du
  // 30-10-2026, « Prix à part ») : deux PRIX DE VENTE de plus, hors contrat et sous contrat, pour la
  // ligne de devis à la demi-journée. Facultatifs (choix par défaut, à confirmer) : une main d'œuvre
  // sans ce prix ne se vend pas à la demi-journée. Une contrainte CHECK les réserve à une main d'œuvre.
  prixDemiJourneeHorsContratHt Decimal?                @db.Decimal(12, 2)
  prixDemiJourneeSousContratHt Decimal?                @db.Decimal(12, 2)
  rattachementsIntervenants IntervenantMainOeuvre[]

  // Cible de la clé étrangère composite des rattachements : seule une main d'œuvre est visée.
  @@unique([id, estMainOeuvre])
  @@index([categorieId])
}

// Rattachement d'un intervenant à une main d'œuvre (décision de Nelson du 24-10-2026, « Liée à
// l'intervenant ») : ses heures seront valorisées à ce prix de vente (lot suivant). Réglé par
// l'administration seule. Une table à part plutôt qu'une colonne de l'intervenant : le
// rattachement ne voyage pas avec les fiches intervenant jointes aux heures, au planning ou aux
// interventions, que lisent des comptes qui ne voient pas le catalogue. La clé étrangère
// composite (prestationId, estMainOeuvre toujours vrai) garantit en base que la cible est, et
// reste, une main d'œuvre ; une main d'œuvre désactivée garde ses rattachements (choix par
// défaut, à confirmer).
model IntervenantMainOeuvre {
  intervenantId String              @id
  intervenant   Intervenant         @relation(fields: [intervenantId], references: [id], onDelete: Cascade)
  prestationId  String
  estMainOeuvre Boolean             @default(true)
  prestation    CataloguePrestation @relation(fields: [prestationId, estMainOeuvre], references: [id, estMainOeuvre], onDelete: Restrict, onUpdate: Restrict)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([prestationId, estMainOeuvre])
}

// Article vendu/consommé : suivi de stock simple, sans traçabilité unitaire obligatoire.
model CatalogueArticle {
  id          String              @id @default(uuid())
  categorieId String?
  categorie   CatalogueCategorie? @relation(fields: [categorieId], references: [id])
  reference   String              @unique
  nom         String
  description String?
  unite       String              @default("unité")
  tauxTva     Decimal             @default(20) @db.Decimal(5, 2)
  prixAchatHt Decimal?            @db.Decimal(12, 2)
  prixVenteHt Decimal             @default(0) @db.Decimal(12, 2)
  stockSuivi  Boolean             @default(false)
  stockActuel Decimal             @default(0) @db.Decimal(12, 3)
  actif       Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([categorieId])
}

// Modèle catalogue d'un matériel sérialisable ; une instance installée crée un EquipementInstalle.
model CatalogueEquipement {
  id          String               @id @default(uuid())
  categorieId String?
  categorie   CatalogueCategorie?  @relation(fields: [categorieId], references: [id])
  reference   String               @unique
  nom         String
  fabricant   String?
  description String?
  tauxTva     Decimal              @default(20) @db.Decimal(5, 2)
  prixAchatHt Decimal?             @db.Decimal(12, 2)
  prixVenteHt Decimal              @default(0) @db.Decimal(12, 2)
  actif       Boolean              @default(true)
  equipements EquipementInstalle[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([categorieId])
}

// Parc réellement installé : série/IMEI/MAC, garantie, client et site restent traçables.
model EquipementInstalle {
  id                    String              @id @default(uuid())
  catalogueEquipementId String
  catalogueEquipement   CatalogueEquipement @relation(fields: [catalogueEquipementId], references: [id])
  clientId              String
  client                Client              @relation(fields: [clientId], references: [id])
  clientSiteId          String
  clientSite            ClientSite          @relation(fields: [clientSiteId], references: [id])
  numeroSerie           String?
  imei                  String?
  adresseMac            String?
  statut                String              @default("INSTALLE")
  installeLe            DateTime?
  garantieJusquAu       DateTime?
  notes                 String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([catalogueEquipementId, numeroSerie])
  @@index([clientId])
  @@index([clientSiteId])
}

model PlanningPublicShare {
  id     String  @id @default("singleton")
  token  String  @unique
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Type d'événement personnalisé du planning d'intervention (Congés, Formation, SAV
// récurrent...), réutilisable, avec sa couleur — créé et géré par les administrateurs
// directement depuis le module Planning.
model PlanningEventType {
  id      String @id @default(uuid())
  nom     String @unique
  couleur String @default("#f59e0b")

  events PlanningEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Affectation du planning d'intervention (module réservé aux administrateurs) : place un
// ou plusieurs techniciens (Intervenant) sur un chantier suivi, un chantier/intervention
// non suivi (ex: SAV — nom et client saisis librement), ou un événement
// personnalisé (congés, formation...). Purement PRÉVISIONNEL : ne crée jamais de
// PointageHeure — les heures réelles des chantiers restent saisies manuellement dans le
// Journal des Heures.
model PlanningEvent {
  id        String @id @default(uuid())
  categorie String // CHANTIER (suivi) | HORS_CHANTIER (non suivi, ex: SAV) | EVENEMENT

  dateDebut  DateTime // premier jour couvert (inclus), stocké à minuit UTC
  dateFin    DateTime // dernier jour couvert (inclus), stocké à minuit UTC
  creneau    String   @default("JOURNEE") // JOURNEE | MATIN | APRES_MIDI | HEURES
  heureDebut String? // "HH:MM" si creneau HEURES
  heureFin   String? // "HH:MM" si creneau HEURES

  // categorie CHANTIER : le chantier suivi affecté
  chantierId String?
  chantier   Chantier? @relation(fields: [chantierId], references: [id])

  // categorie HORS_CHANTIER : nom libre + client + adresse (jamais liés à un enregistrement
  // en base — contrairement à categorie CHANTIER, il n'existe pas de fiche à côté de
  // laquelle stocker/corriger ces informations, elles vivent uniquement sur l'affectation).
  // adresse saisie librement, corrigible à tout moment.
  titre   String?
  client  String?
  adresse String?

  // categorie EVENEMENT : type réutilisable (libellé + couleur)
  typeEventId String?
  typeEvent   PlanningEventType? @relation(fields: [typeEventId], references: [id])

  commentaire String?

  // Projection unique d'un dossier SAV : le planning ne duplique plus son titre, client ou
  // ses techniciens. Les événements libres HORS_CHANTIER demeurent utilisables hors SAV.
  interventionId String? @unique
  intervention   Intervention? @relation(fields: [interventionId], references: [id], onDelete: Cascade)

  intervenants Intervenant[] @relation("PlanningEventIntervenants")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chantierId])
  @@index([typeEventId])
}


// Suivi administratif (qualité et rigueur) d'un commercial, validé manuellement par un
// administrateur, mois par mois, faute de pouvoir être déduit des données de gestion.
// Sans plan commercial, il n'ouvre aucune prime (décision du 17-10-2026).
model PrimeMensuelleCommercial {
  id                 String  @id @default(uuid())
  periode            String // "YYYY-MM"
  suiviAdministratif Boolean @default(false)

  commercialId String
  commercial   User   @relation(fields: [commercialId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([commercialId, periode])
}
