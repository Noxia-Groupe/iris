generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  role      String   @default("CONDUCTEUR_TRAVAUX") // ADMIN ou CONDUCTEUR_TRAVAUX
  password  String?
  
  chantiersGeres Chantier[] // Liaison pour restreindre la vue des chefs de chantier
  photos         PhotoChantier[] // Photos uploadées par l'utilisateur
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Fournisseur {
  id        String   @id @default(uuid())
  nom       String   @unique
  contact   String?
  
  achats    AchatReel[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Chantier {
  id                    String                    @id @default(uuid())
  nom                   String
  numeroDevis           String?
  client                String
  dateDebut             DateTime
  dateFin               DateTime?
  statut                String                    @default("EN_COURS")
  
  budgetGlobalVendu     Float
  budgetMaterielVendu   Float                     @default(0)
  budgetMainOeuvreVendu Float                     @default(0)
  heuresVendues         Float                     @default(0)
  
  responsableId         String?
  responsable           User?                     @relation(fields: [responsableId], references: [id])
  
  lignesBudget          LigneBudgetPrevisionnel[]
  achats                AchatReel[]
  pointages             PointageHeure[]
  photos                PhotoChantier[]
  commissionnement      Commissionnement?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Categorie {
  id          String                    @id @default(uuid())
  nom         String                    @unique
  description String?
  
  lignesBudget LigneBudgetPrevisionnel[]
  achats       AchatReel[]
}

model LigneBudgetPrevisionnel {
  id             String    @id @default(uuid())
  chantierId     String
  categorieId    String
  montantAlloue  Float
  heuresAllouees Float?

  chantier       Chantier  @relation(fields: [chantierId], references: [id])
  categorie      Categorie @relation(fields: [categorieId], references: [id])

  @@unique([chantierId, categorieId])
}

model AchatReel {
  id              String      @id @default(uuid())
  date            DateTime
  
  fournisseurId   String
  fournisseur     Fournisseur @relation(fields: [fournisseurId], references: [id])
  numeroFacture   String?
  
  description     String
  montantHT       Float
  
  chantierId      String
  chantier        Chantier    @relation(fields: [chantierId], references: [id])
  
  categorieId     String
  categorie       Categorie   @relation(fields: [categorieId], references: [id])

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model Intervenant {
  id                 String          @id @default(uuid())
  nom                String
  role               String
  tauxHoraireCharge  Float

  pointages          PointageHeure[]
}

model PointageHeure {
  id                   String      @id @default(uuid())
  date                 DateTime
  intervenantId        String
  chantierId           String
  nbrHeures            Float
  tauxHoraireApplique  Float
  commentaire          String?

  intervenant          Intervenant @relation(fields: [intervenantId], references: [id])
  chantier             Chantier    @relation(fields: [chantierId], references: [id])
  
  createdAt            DateTime    @default(now())
}

model PhotoChantier {
  id          String   @id @default(uuid())
  url         String
  legende     String?
  chantierId  String
  chantier    Chantier @relation(fields: [chantierId], references: [id])
  auteurId    String?
  auteur      User?    @relation(fields: [auteurId], references: [id])
  createdAt   DateTime @default(now())
}

// Paramètres globaux configurables par les administrateurs (singleton).
model Parametres {
  id                     String   @id @default("singleton")
  margeCommercialeActive Boolean  @default(true)  // affichage/calcul de la marge commerciale
  tauxHoraireMoyen       Float    @default(30)     // valorisation €/h du bonus/malus dynamique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Commissionnement {
  id          String   @id @default(uuid())
  mode        String   @default("FIXE") // FIXE ou DYNAMIQUE
  tauxFixe    Float    @default(0)      // % commission sur marge fixe
  bonusHeure  Float    @default(0)      // % bonus si avance
  malusHeure  Float    @default(0)      // % malus si retard
  
  chantierId  String   @unique
  chantier    Chantier @relation(fields: [chantierId], references: [id])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
