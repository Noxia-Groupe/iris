generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  role      String   @default("CONDUCTEUR_TRAVAUX") // ADMIN ou CONDUCTEUR_TRAVAUX
  password  String?
  
  chantiersGeres Chantier[] // Liaison pour restreindre la vue des chefs de chantier
  photos         PhotoChantier[] // Photos uploadées par l'utilisateur
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Fournisseur {
  id        String   @id @default(uuid())
  nom       String   @unique
  contact   String?
  
  achats    AchatReel[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Chantier {
  id                    String                    @id @default(uuid())
  nom                   String
  numeroDevis           String?
  client                String
  dateDebut             DateTime
  dateFin               DateTime?
  statut                String                    @default("EN_COURS")
  
  budgetGlobalVendu     Decimal                   @db.Decimal(12, 2)
  budgetMaterielVendu   Decimal                   @default(0) @db.Decimal(12, 2)
  budgetMainOeuvreVendu Decimal                   @default(0) @db.Decimal(12, 2)
  heuresVendues         Decimal                   @default(0) @db.Decimal(10, 2)
  
  responsableId         String?
  responsable           User?                     @relation(fields: [responsableId], references: [id])
  
  lignesBudget          LigneBudgetPrevisionnel[]
  achats                AchatReel[]
  pointages             PointageHeure[]
  photos                PhotoChantier[]
  commissionnement      Commissionnement?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Categorie {
  id          String                    @id @default(uuid())
  nom         String                    @unique
  description String?
  
  lignesBudget LigneBudgetPrevisionnel[]
  achats       AchatReel[]
}

model LigneBudgetPrevisionnel {
  id             String    @id @default(uuid())
  chantierId     String
  categorieId    String
  montantAlloue  Decimal   @db.Decimal(12, 2)
  heuresAllouees Decimal?  @db.Decimal(10, 2)

  chantier       Chantier  @relation(fields: [chantierId], references: [id])
  categorie      Categorie @relation(fields: [categorieId], references: [id])

  @@unique([chantierId, categorieId])
}

model AchatReel {
  id              String      @id @default(uuid())
  date            DateTime
  
  fournisseurId   String
  fournisseur     Fournisseur @relation(fields: [fournisseurId], references: [id])
  numeroFacture   String?
  
  description     String
  montantHT       Decimal     @db.Decimal(12, 2)
  
  chantierId      String
  chantier        Chantier    @relation(fields: [chantierId], references: [id])
  
  categorieId     String
  categorie       Categorie   @relation(fields: [categorieId], references: [id])

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model Intervenant {
  id                 String          @id @default(uuid())
  nom                String
  role               String
  tauxHoraireCharge  Decimal         @db.Decimal(10, 2)

  pointages          PointageHeure[]
}

model PointageHeure {
  id                   String      @id @default(uuid())
  date                 DateTime
  intervenantId        String
  chantierId           String
  nbrHeures            Decimal     @db.Decimal(10, 2)
  tauxHoraireApplique  Decimal     @db.Decimal(10, 2)
  commentaire          String?

  intervenant          Intervenant @relation(fields: [intervenantId], references: [id])
  chantier             Chantier    @relation(fields: [chantierId], references: [id])
  
  createdAt            DateTime    @default(now())
}

model PhotoChantier {
  id          String   @id @default(uuid())
  url         String
  legende     String?
  chantierId  String
  chantier    Chantier @relation(fields: [chantierId], references: [id])
  auteurId    String?
  auteur      User?    @relation(fields: [auteurId], references: [id])
  createdAt   DateTime @default(now())
}

// Paramètres globaux configurables par les administrateurs (singleton).
model Parametres {
  id                     String   @id @default("singleton")
  margeCommercialeActive Boolean  @default(true)  // affichage/calcul de la marge commerciale

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Commissionnement {
  id          String   @id @default(uuid())
  mode        String   @default("FIXE") // FIXE ou DYNAMIQUE
  tauxFixe    Decimal  @default(0) @db.Decimal(6, 2)  // taux de commission de base (% de la marge)
  bonusHeure  Decimal  @default(0) @db.Decimal(6, 2)  // points de % ajoutés au taux si en avance (mode DYNAMIQUE)
  malusHeure  Decimal  @default(0) @db.Decimal(6, 2)  // points de % retirés du taux si en retard (mode DYNAMIQUE)
  
  chantierId  String   @unique
  chantier    Chantier @relation(fields: [chantierId], references: [id])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
