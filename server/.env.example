# Backend — variables d'environnement (copier en server/.env).

# Connexion PostgreSQL.
# - En Docker (docker-compose) : laissez vide, la valeur est injectée automatiquement
#   par compose à partir du service "db".
# - En développement local hors Docker : pointez vers votre PostgreSQL.
DATABASE_URL="postgresql://marge:marge_password@localhost:5432/marge?schema=public"

# OBLIGATOIRE en production : clé de signature des tokens JWT (longue chaîne aléatoire).
# Le serveur refuse de démarrer en production si elle est absente.
JWT_SECRET="changez_moi_par_une_longue_chaine_aleatoire"

# Compte administrateur créé au 1er lancement (uniquement si la base est vide).
ADMIN_EMAIL="admin@votre-domaine.com"
ADMIN_PASSWORD="un_mot_de_passe_robuste"

# Optionnel : comptes SUPER ADMINISTRATEUR (emails séparés par des virgules). Ces comptes
# sont créés — ou promus s'ils existent déjà — à CHAQUE démarrage du serveur : ils ne
# peuvent donc jamais être perdus. Le superadmin possède tous les droits d'un
# administrateur, plus la gestion des comptes superadmin et l'activation/désactivation des
# modules de l'application (Administration > Modules, ex : le Planning). Laisser vide
# utilise la liste par défaut : nelson@noxia-groupe.fr et admin@cybexia.fr.
# Le compte admin@cybexia.fr reçoit ADMIN_PASSWORD comme mot de passe local S'IL est créé
# ici pour la première fois ; un compte déjà existant conserve le sien.
SUPERADMIN_EMAILS=""

# Optionnel : active le rapport IA (laisser vide pour désactiver la fonction).
GEMINI_API_KEY=""

# Optionnel : SSO Microsoft 365 (OpenID Connect). Renseignez l'app Azure AD pour activer
# la connexion Microsoft. Côté Azure, l'app doit être de type "SPA" (Single-Page
# Application) avec, comme URI de redirection, l'ORIGINE exacte de l'application
# (ex : https://marge.cybexia.fr). La liste des comptes autorisés et leurs rôles se gère
# dans l'app (Administration > Utilisateurs) ; un compte absent se voit refuser l'accès.
# Laisser vide = SSO inactif. Ces deux valeurs ne sont pas secrètes (exposées à la SPA).
AZURE_TENANT_ID=""
AZURE_CLIENT_ID=""

# Optionnel : recherche des clients Odoo Online (lecture seule) pour préremplir le champ
# "Client" d'un chantier. Laisser vide = recherche indisponible, saisie libre du client
# (comportement actuel). L'application ne fait jamais d'écriture dans Odoo (aucun
# create/write/unlink).
# - ODOO_URL : URL de votre instance (ex : https://votresociete.odoo.com), sans slash final.
# - ODOO_DB : nom de la base de données Odoo (souvent identique au sous-domaine).
# - ODOO_USERNAME : email du compte technique utilisé pour l'API.
# - ODOO_API_KEY : clé API de ce compte, à générer dans Odoo via l'icône de profil en
#   haut à droite > Paramètres de compte > Sécurité du compte > Clés API > Nouvelle clé
#   (utilisez une clé API, jamais le mot de passe du compte).
ODOO_URL=""
ODOO_DB=""
ODOO_USERNAME=""
ODOO_API_KEY=""

# Optionnel : titre (ou fragment de titre) de la section de devis à considérer comme
# "Matériel" pour préremplir automatiquement le champ "Dont Matériel" d'un chantier à
# partir du devis Odoo sélectionné (sous-total de cette section). Comparaison insensible
# à la casse et aux accents. Laisser vide = "materiel" (matche "Matériel", "MATERIEL", etc.).
ODOO_SECTION_MATERIEL_LABEL=""

PORT=3001
