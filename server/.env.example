# Backend — variables d'environnement (copier en server/.env).

# Connexion PostgreSQL.
# - En Docker (docker-compose) : laissez vide, la valeur est injectée automatiquement
#   par compose à partir du service "db".
# - En développement local hors Docker : pointez vers votre PostgreSQL.
DATABASE_URL="postgresql://iris:***@localhost:5432/iris?schema=public"

# OBLIGATOIRE en production : clé de signature des tokens JWT (longue chaîne aléatoire).
# Le serveur refuse de démarrer en production si elle est absente.
JWT_SECRET="changez_moi_par_une_longue_chaine_aleatoire"


# Optionnel : comptes SUPER ADMINISTRATEUR (emails séparés par des virgules). Ces comptes
# sont créés — ou promus s'ils existent déjà — à CHAQUE démarrage du serveur : ils ne
# peuvent donc jamais être perdus. Le superadmin possède tous les droits d'un
# administrateur, plus la gestion des comptes superadmin et l'activation/désactivation des
# modules de l'application (Administration > Modules, ex : le Planning).
#
# OBLIGATOIRE au premier démarrage d'une instance neuve : sans cette liste, AUCUN compte
# d'administration n'est créé — le code ne contient volontairement plus d'email par défaut,
# pour qu'une instance livrée à un client ne crée pas d'office un compte appartenant à
# l'éditeur. Sur une instance déjà en service, laisser vide ne retire rien : les comptes
# superadmin existants sont conservés.
# Tous les comptes se connectent exclusivement avec Microsoft Entra ID.
SUPERADMIN_EMAILS=""

# Optionnel : active le rapport IA (laisser vide pour désactiver la fonction).
GEMINI_API_KEY=""

# OBLIGATOIRE : Microsoft Entra ID (OpenID Connect) est la connexion NORMALE de
# l'application — il n'existe plus de mot de passe local. Sans ces deux valeurs, seul
# l'accès de secours ci-dessous permet d'entrer. Côté Azure, l'app doit être de type "SPA" (Single-Page
# Application) avec, comme URI de redirection, l'ORIGINE exacte de l'application
# (ex : https://iris.votre-societe.fr). La liste des comptes autorisés et leurs rôles se gère
# dans l'app (Administration > Utilisateurs) ; un compte absent se voit refuser l'accès.
# Ces deux valeurs ne sont pas secrètes (elles sont exposées à la SPA).
AZURE_TENANT_ID=""
AZURE_CLIENT_ID=""

# --- Accès de secours du super administrateur (« break-glass ») ---
# Porte de service, à n'utiliser que si Microsoft Entra ID est indisponible ou mal
# configuré : panne du tenant, application Azure supprimée, migration, compte verrouillé.
# Sans elle, une instance dont le SSO tombe devient inadministrable — personne ne peut plus
# entrer, pas même pour réparer.
#
# Renseignez les DEUX valeurs pour l'activer (laisser vide = accès de secours inactif) :
# - BREAK_GLASS_EMAIL : l'email du compte de direction. Il doit exister dans l'application,
#   être actif et avoir le rôle SUPERADMIN, sinon la porte reste fermée même avec le bon
#   jeton.
# - BREAK_GLASS_TOKEN : secret d'AU MOINS 32 caractères, généré aléatoirement. Un secret
#   plus court désactive le mécanisme (avertissement au démarrage) plutôt que d'offrir une
#   fausse sécurité. Générez-le sur le VPS :
#       openssl rand -base64 48
#
# Utilisation : https://<votre-instance>/secours — coller le jeton, ou l'enregistrer en
# signet sous la forme https://<votre-instance>/secours#token=LE_JETON (le fragment après
# le # n'est jamais transmis au serveur, donc jamais écrit dans les journaux nginx).
# La session ouverte dure 1 heure, contre 7 jours pour une connexion Microsoft.
#
# Ce jeton vaut un accès administrateur complet : il ne doit exister que dans ce fichier
# sur le VPS et dans votre gestionnaire de mots de passe. Jamais dans Git, jamais par
# e-mail. Changez-le après chaque utilisation réelle.
BREAK_GLASS_EMAIL=""
BREAK_GLASS_TOKEN=""

# Optionnel : intégration Odoo Online (LECTURE SEULE). Elle alimente deux choses :
#   - le préremplissage des champs d'un chantier (client, devis, montants, adresse) ;
#   - l'écran « Suivi financier » (réservé au superadmin), qui rapproche chaque chantier
#     de son devis de vente pour afficher les acomptes versés et le restant dû.
# Laisser vide = recherche indisponible, saisie libre du client (comportement actuel), et
# écran Suivi financier sans données. L'application ne fait jamais d'écriture dans Odoo (aucun
# create/write/unlink).
# - ODOO_URL : URL de votre instance (ex : https://votresociete.odoo.com), sans slash final.
# - ODOO_DB : nom de la base de données Odoo (souvent identique au sous-domaine).
# - ODOO_USERNAME : email du compte technique utilisé pour l'API.
# - ODOO_API_KEY : clé API de ce compte, à générer dans Odoo via l'icône de profil en
#   haut à droite > Paramètres de compte > Sécurité du compte > Clés API > Nouvelle clé
#   (utilisez une clé API, jamais le mot de passe du compte).
ODOO_URL=""
ODOO_DB=""
ODOO_USERNAME=""
ODOO_API_KEY=""

# Optionnel : titre (ou fragment de titre) de la section de devis à considérer comme
# "Matériel" pour préremplir automatiquement le champ "Dont Matériel" d'un chantier à
# partir du devis Odoo sélectionné (sous-total de cette section). Comparaison insensible
# à la casse et aux accents. Laisser vide = "materiel" (matche "Matériel", "MATERIEL", etc.).
ODOO_SECTION_MATERIEL_LABEL=""

# Optionnel : réglages de l'écran « Suivi financier ».
# - ODOO_CACHE_TTL_SECONDS : durée pendant laquelle les lectures Odoo (commandes, factures,
#   paiements) sont réutilisées sans réinterroger le serveur. Le parc compte des centaines
#   d'affaires closes et soldées qui ne bougent plus ; les relire à chaque affichage serait
#   inutile et lent. Le bouton « Actualiser » de l'écran force une relecture immédiate.
#   Laisser vide = 600 (10 minutes).
# - ODOO_LIMITE_COMMANDES : nombre maximal de commandes vendues remontées par l'onglet
#   « Anciens chantiers ». Laisser vide = 1500. L'écran signale s'il a atteint ce plafond.
ODOO_CACHE_TTL_SECONDS=""
ODOO_LIMITE_COMMANDES=""

PORT=3001
